# Copy to .env and fill in. Never commit real values that are secret.
# These VITE_ variables are bundled into the public site, so only put PUBLIC values here.

# WhatsApp number for orders, digits only with country code (e.g. the restaurant's number). Leave empty until provided.
VITE_WHATSAPP_NUMBER=

# Public HTTPS endpoint that accepts the contact form as JSON (POST). Leave empty until a backend/form service exists.
VITE_CONTACT_ENDPOINT=

# Optional public endpoint that accepts orders as JSON (POST). Leave empty until a backend exists.
VITE_ORDER_ENDPOINT=

# Google Maps embed URL (the "src" of the iframe from Google Maps > Share > Embed a map). Leave empty until the address is known.
VITE_MAP_EMBED_URL=
